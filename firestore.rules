rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwnerRole() {
      return isAuthed() && getRole() == 'owner';
    }

    function isVendorRole() {
      return isAuthed() && getRole() == 'vendor';
    }

    function isCollaboratorRole() {
      return isAuthed() && getRole() == 'collaborator';
    }

    function requestDoc(requestId) {
      return get(/databases/$(database)/documents/requests/$(requestId)).data;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Users can read their own profile; owners can also read any user doc
    // (needed to list vendors/collaborators for the assignment dropdowns).
    // No client writes at all — role assignment is console-only, same as
    // pre-pivot (see docs/SETUP.md); there's no self-serve signup yet.
    match /users/{userId} {
      allow read: if isAuthed() && (request.auth.uid == userId || isOwnerRole());
      allow write: if false;
    }

    // ── Properties ────────────────────────────────────────────────────────
    // A property belongs to exactly one owner (BRL1). Only that owner can
    // read, create, update, or delete it — there is no cross-owner sharing
    // of properties in v1.1 (household/vendor sharing works at the request
    // level for now; see BRL5/BRL6 and ROADMAP.md v1.2 Package 10).
    match /properties/{propertyId} {
      allow read: if isOwnerRole() && resource.data.ownerUid == request.auth.uid;
      allow create: if isOwnerRole() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwnerRole() && resource.data.ownerUid == request.auth.uid;
    }

    // ── Requests ──────────────────────────────────────────────────────────
    // Replaces the pre-pivot `projects` collection. Read is scoped three
    // ways, closing the legacy vendor over-read gap (BRL6): an owner reads
    // only their own requests, a vendor reads only the request they're
    // assigned to, a collaborator reads only the request explicitly shared
    // with them — never "any request," unlike the old tech/client model.
    match /requests/{requestId} {
      allow read: if isAuthed() && (
        (isOwnerRole() && resource.data.ownerUid == request.auth.uid) ||
        (isVendorRole() && resource.data.assignedVendorUid == request.auth.uid) ||
        (isCollaboratorRole() && resource.data.collaboratorUid == request.auth.uid)
      );
      allow create: if isOwnerRole() && request.resource.data.ownerUid == request.auth.uid;
      // Vendors can update a request they're assigned to (e.g. moving
      // status to "In Progress"/"Needs Review") but not reassign or delete it.
      allow update: if isAuthed() && (
        (isOwnerRole() && resource.data.ownerUid == request.auth.uid) ||
        (isVendorRole() && resource.data.assignedVendorUid == request.auth.uid)
      );
      allow delete: if isOwnerRole() && resource.data.ownerUid == request.auth.uid;

      // Photos subcollection — real Firestore-assigned document IDs now
      // (not a task-array-index string), which also resolves the legacy
      // task-identity/cascading-delete gap noted in the pre-pivot
      // ARCHITECTURE.md: there's no "index beyond the current array
      // length" concept left to orphan.
      match /photos/{photoId} {
        allow read: if isAuthed() && (
          (isOwnerRole() && requestDoc(requestId).ownerUid == request.auth.uid) ||
          (isVendorRole() && requestDoc(requestId).assignedVendorUid == request.auth.uid) ||
          (isCollaboratorRole() && requestDoc(requestId).collaboratorUid == request.auth.uid)
        );
        allow create: if isAuthed() && request.auth.uid == request.resource.data.uploadedByUid && (
          (isOwnerRole() && requestDoc(requestId).ownerUid == request.auth.uid) ||
          (isVendorRole() && requestDoc(requestId).assignedVendorUid == request.auth.uid)
        );
        allow update: if false; // photos are immutable evidence once uploaded
        allow delete: if isOwnerRole() && requestDoc(requestId).ownerUid == request.auth.uid;
      }
    }

    // ── Contacts ──────────────────────────────────────────────────────────
    // Any authenticated user can read contacts; only an owner manages them.
    match /contacts/{contactId} {
      allow read: if isAuthed();
      allow create, update, delete: if isOwnerRole();
    }
  }
}
