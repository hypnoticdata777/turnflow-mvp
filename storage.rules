rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // Cross-service lookups into the same collections firestore.rules
    // checks, so Storage and Firestore never disagree about who can see
    // or write a file.
    function getRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function getRequest(requestId) {
      return firestore.get(/databases/(default)/documents/requests/$(requestId)).data;
    }

    // turnflow/{requestId}/{type}/{uid}/{fileName}
    // Mirrors the requests/{id}/photos/{id} Firestore rule above: read is
    // scoped to the request's owner, its assigned vendor, or its shared
    // collaborator; write requires the uploader's own uid on the path AND
    // being either the owner or the assigned vendor. This closes the
    // legacy read-scoping gap (any authenticated user could previously
    // read any photo) as part of the v1.1 role rewrite.
    match /turnflow/{requestId}/{type}/{uid}/{fileName} {
      allow read: if isAuthed() && (
        (getRole() == 'owner' && getRequest(requestId).ownerUid == request.auth.uid) ||
        (getRole() == 'vendor' && getRequest(requestId).assignedVendorUid == request.auth.uid) ||
        (getRole() == 'collaborator' && getRequest(requestId).collaboratorUid == request.auth.uid)
      );
      allow write: if isAuthed() && request.auth.uid == uid && (
        (getRole() == 'owner' && getRequest(requestId).ownerUid == request.auth.uid) ||
        (getRole() == 'vendor' && getRequest(requestId).assignedVendorUid == request.auth.uid)
      );
      allow delete: if isAuthed() && getRole() == 'owner' && getRequest(requestId).ownerUid == request.auth.uid;
    }

    // Deny everything outside the known upload path by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
